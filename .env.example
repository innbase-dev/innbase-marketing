# Referrals backend integration
#
# Server-only. Read exclusively by src/app/refer/api/trpc/[...trpc]/route.js
# (the BFF proxy) -- never exposed to the browser bundle, and deliberately
# NOT prefixed with NEXT_PUBLIC_. The bare origin of the Innbase API, with
# no trailing slash and no /trpc suffix (the proxy appends /trpc itself;
# see api/src/main.ts, which mounts tRPC directly on / not under /api).
INNBASE_API_URL=http://localhost:4000

# Clerk. Required for /refer/sign-in, /refer/sign-up and /refer/portal.
# The public /refer page and referral-token lookup do not require Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional local development compatibility only, on BOTH frontend and API.
# Never enabled in a production build; production API verifies Clerk tokens.
INNBASE_REFERRALS_DEV_IDENTITY=false
